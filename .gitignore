# ==========================================
# Evo（衍界）專案 .gitignore
# ==========================================

# ------------------------------------------
# Python 執行與字節碼快取
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ------------------------------------------
# Python 虛擬環境
# ------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------
# 測試、測試覆蓋率與 Linter 快取
# ------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ------------------------------------------
# Python 打包與構建產物（僅忽略根目錄 build/dist）
# ------------------------------------------
/build/
/dist/
*.egg-info/
*.egg
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/

# ------------------------------------------
# Node.js / 前端 (observer/web) 依賴與快取
# ------------------------------------------
node_modules/
.npm
.pnpm-store
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 註：README 註明 observer/web/dist 已預先編譯以便開箱即用；
# 若未來希望前端 dist 不入版本控制，可取消下一行註解：
# /observer/web/dist/

# ------------------------------------------
# Evo 系統執行期資料庫、快照與臨時目錄
# ------------------------------------------
# SQLite 執行期資料庫與 WAL 檔案
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# 執行期日誌
*.log

# 受控套件 bootstrap 快取（由 sandbox-requirements.txt 可重建）
**/.evo-packages/
**/.evo-packages.previous/
**/.evo-packages-stage-*/
**/.evo-packages-home-*/

# 所有可重置的世界程式、記憶、設定、日誌與快照
/runtime/
# 舊版可能留下的執行期目錄；新版本不再讀寫這些路徑
/habitat/
/history/
/backups/
*.sqlite

# 原子部署臨時目錄
.habitat.deploy-*
.habitat.previous-*

# ------------------------------------------
# 編輯器與 IDE 設定
# ------------------------------------------
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ------------------------------------------
# 作業系統與系統隱藏檔
# ------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------
# 環境變數與機密金鑰
# ------------------------------------------
.env
.env.local
.env.*
!.env.example
*.pem
*.key

# TypeScript 增量編譯快取
*.tsbuildinfo
